# Supabase — Project Settings → API
# Only needed at runtime (Vercel); `npm run build` passes without them.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"

# Public base URL for customer tracking links (no trailing slash), e.g.
# https://kadexautodz.vercel.app or a custom domain. Used to build absolute
# /suivi/<token> links for WhatsApp sharing. On Vercel this falls back to
# VERCEL_URL automatically, but set this to your stable production domain.
NEXT_PUBLIC_SITE_URL="https://YOUR-DOMAIN.vercel.app"
